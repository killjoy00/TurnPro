{
  "name": "turn-pro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc && npm test",
    "test": "node --test",
    "simulate": "node scripts/simulate.mjs",
    "smoke": "node scripts/browser-smoke.mjs && node scripts/gamepad-smoke.mjs && node scripts/launch-smoke.mjs",
    "simulate:soccer": "node scripts/simulate-soccer.mjs",
    "desktop:package": "npm run build && node scripts/package-desktop.mjs",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "build:launch": "node scripts/build.mjs --launch",
    "desktop:launch": "npm run build:launch && node scripts/package-desktop.mjs --launch",
    "steam:preview": "node scripts/steampipe-preview.mjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "typescript": "6.0.3"
  }
}
